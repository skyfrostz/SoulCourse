APP_ENV=production
SOULCOURSE_PUBLIC_HEALTH_URL=https://<public-domain>/readyz
APP_NAME=选科π
HTTP_PORT=1309
TRUSTED_PROXIES=127.0.0.1,::1
FRONTEND_DIST_DIR=/opt/soulcourse/current/frontend/dist

# 可选 OTLP/HTTP traces。生产默认 TLS；私有 CA 时填写 PEM 文件路径。
OTEL_EXPORTER_OTLP_ENDPOINT=https://<otel-collector>:4318
OTEL_SERVICE_NAME=subject-choice-forum
OTEL_EXPORTER_OTLP_INSECURE=false
OTEL_EXPORTER_OTLP_CERTIFICATE=

CORS_ALLOWED_ORIGINS=https://soulcourse.cn,https://www.soulcourse.cn

# 托管 PostgreSQL 16（生产禁止回退 SQLite）
DATABASE_DRIVER=postgres
DATABASE_URL=postgres://<user>:<password>@<host>:5432/<database>?sslmode=require
DATABASE_MAX_OPEN_CONNS=20
DATABASE_MAX_IDLE_CONNS=5
DATABASE_CONNECT_TIMEOUT=10s
DATABASE_QUERY_TIMEOUT=5s
DATABASE_HEALTH_TIMEOUT=2s

# S3 兼容对象存储；凭证使用 AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY
# 或实例角色等 AWS SDK 默认凭证链注入。
STORAGE_DRIVER=s3
S3_ENDPOINT=https://<s3-endpoint>
S3_BUCKET=<bucket>
S3_REGION=<region>
S3_CDN_BASE_URL=https://<cdn-domain>
S3_FORCE_PATH_STYLE=false

JWT_SECRET=<用 openssl rand -hex 32 生成>
METRICS_TOKEN=<用 openssl rand -hex 32 生成>
ADMIN_EMAIL=<后台管理员邮箱>
ADMIN_ROLE=super_admin
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=<后台管理员密码的 bcrypt 哈希>

# 腾讯企业邮箱 SMTP
SMTP_HOST=smtp.exmail.qq.com
SMTP_PORT=465
SMTP_USERNAME=no-reply@soulcourse.cn
SMTP_PASSWORD=<企业邮箱客户端专用密码>
SMTP_FROM_EMAIL=no-reply@soulcourse.cn
SMTP_REPLY_TO=contact@soulcourse.cn
SMTP_FROM_NAME=选科π
SMTP_USE_TLS=true
SMTP_START_TLS=false
EMAIL_VERIFICATION_TTL_MINUTES=10
EMAIL_VERIFICATION_SUBJECT=选科π邮箱验证码
EMAIL_VERIFICATION_COOLDOWN_SECONDS=60
EMAIL_VERIFICATION_EMAIL_HOURLY_LIMIT=5
EMAIL_VERIFICATION_IP_HOURLY_LIMIT=20
EMAIL_VERIFICATION_MAX_VALIDATION_ATTEMPTS=5

AI_API_KEY=<你的 DeepSeek API 密钥>
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat
