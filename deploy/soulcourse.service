[Unit]
Description=SoulCourse web application
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=soulcourse
Group=soulcourse
WorkingDirectory=/opt/soulcourse/current
EnvironmentFile=/etc/soulcourse/soulcourse.env
ExecStart=/opt/soulcourse/current/deploy/run-production.sh
Restart=on-failure
RestartSec=10
TimeoutStopSec=15
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/soulcourse

[Install]
WantedBy=multi-user.target
